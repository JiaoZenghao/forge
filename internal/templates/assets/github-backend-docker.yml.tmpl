name: Backend
on:
  push: {paths: ['{{.Path}}/**', '.github/workflows/backend-ci.yml']}
  pull_request: {paths: ['{{.Path}}/**', '.github/workflows/backend-ci.yml']}
permissions: {contents: read}
jobs:
  package:
    runs-on: ubuntu-latest
    defaults: {run: {working-directory: '{{.Path}}'}}
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-java@v5
        with: {distribution: temurin, java-version: '21', cache: maven}
      - run: ./mvnw --batch-mode test
      - run: ./mvnw --batch-mode -DskipTests package
      - uses: actions/upload-artifact@v7
        with: {name: backend-jar, path: '{{.Path}}/target/*.jar', if-no-files-found: error}
  image:
    needs: package
    permissions: {contents: read, packages: write}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - uses: actions/download-artifact@v5
        with: {name: backend-jar, path: '{{.Path}}/target'}
      - id: image
        run: 'echo "name=ghcr.io/${GITHUB_REPOSITORY,,}/backend:${GITHUB_SHA}" >> "$GITHUB_OUTPUT"'
      - uses: docker/setup-buildx-action@v4
      - uses: docker/login-action@v3
        if: github.event_name == 'push' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
        with: {registry: ghcr.io, username: '${{ github.actor }}', password: '${{ secrets.GITHUB_TOKEN }}'}
      - uses: docker/build-push-action@v6
        with: {context: '{{.Path}}', push: "${{ github.event_name == 'push' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}", tags: '${{ steps.image.outputs.name }}'}
