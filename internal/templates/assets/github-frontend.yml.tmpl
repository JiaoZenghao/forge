name: Frontend
on:
  push: {paths: ['{{.Path}}/**', '.github/workflows/frontend-ci.yml']}
  pull_request: {paths: ['{{.Path}}/**', '.github/workflows/frontend-ci.yml']}
permissions: {contents: read}
jobs:
  build:
    runs-on: ubuntu-latest
    defaults: {run: {working-directory: '{{.Path}}'}}
    steps:
      - uses: actions/checkout@v6
      - uses: actions/setup-node@v7
        with: {node-version: 22, cache: npm, cache-dependency-path: '{{.Path}}/package-lock.json'}
      - run: npm ci
      - run: npm run lint
      - run: npm test --if-present
      - run: npm run build
