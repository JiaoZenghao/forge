name: Python
on:
  push: {paths: ['{{.Path}}/**', '.github/workflows/python-ci.yml']}
  pull_request: {paths: ['{{.Path}}/**', '.github/workflows/python-ci.yml']}
permissions: {contents: read}
jobs:
  test:
    runs-on: ubuntu-latest
    defaults: {run: {working-directory: '{{.Path}}'}}
    steps:
      - uses: actions/checkout@v6
      - uses: astral-sh/setup-uv@v9
        with: {enable-cache: true, cache-dependency-glob: '{{.Path}}/uv.lock'}
      - run: uv sync --locked
      - run: uv run python -m compileall .
