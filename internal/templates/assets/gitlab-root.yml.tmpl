# Forge-owned CI entrypoint.
stages: [test, package, image]

workflow:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_OPEN_MERGE_REQUESTS'
      when: never
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - when: never

forge:noop:
  stage: test
  image: alpine:3.22
  script: ['echo "Forge path filters selected this pipeline"']

include:
{{- if .Frontend }}
  - local: .gitlab/frontend-ci.yml
    rules:
      - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
        changes: [{{.FrontendPath}}/**/*, .gitlab/frontend-ci.yml, .gitlab-ci.yml]
      - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BEFORE_SHA == "0000000000000000000000000000000000000000" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
        exists: [{{.FrontendPath}}/package-lock.json]
      - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BEFORE_SHA == "0000000000000000000000000000000000000000"'
        changes:
          paths: [{{.FrontendPath}}/**/*, .gitlab/frontend-ci.yml, .gitlab-ci.yml]
          compare_to: 'refs/heads/$CI_DEFAULT_BRANCH'
      - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BEFORE_SHA != "0000000000000000000000000000000000000000" && $CI_COMMIT_TAG == null'
        changes: [{{.FrontendPath}}/**/*, .gitlab/frontend-ci.yml, .gitlab-ci.yml]
{{- end }}
{{- if .Backend }}
  - local: .gitlab/backend-ci.yml
    rules:
      - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
        changes: [{{.BackendPath}}/**/*, .gitlab/backend-ci.yml, .gitlab-ci.yml]
      - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BEFORE_SHA == "0000000000000000000000000000000000000000" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
        exists: [{{.BackendPath}}/pom.xml]
      - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BEFORE_SHA == "0000000000000000000000000000000000000000"'
        changes:
          paths: [{{.BackendPath}}/**/*, .gitlab/backend-ci.yml, .gitlab-ci.yml]
          compare_to: 'refs/heads/$CI_DEFAULT_BRANCH'
      - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BEFORE_SHA != "0000000000000000000000000000000000000000" && $CI_COMMIT_TAG == null'
        changes: [{{.BackendPath}}/**/*, .gitlab/backend-ci.yml, .gitlab-ci.yml]
{{- end }}
{{- if .Python }}
  - local: .gitlab/python-ci.yml
    rules:
      - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
        changes: [{{.PythonPath}}/**/*, .gitlab/python-ci.yml, .gitlab-ci.yml]
      - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BEFORE_SHA == "0000000000000000000000000000000000000000" && $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH'
        exists: [{{.PythonPath}}/uv.lock]
      - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BEFORE_SHA == "0000000000000000000000000000000000000000"'
        changes:
          paths: [{{.PythonPath}}/**/*, .gitlab/python-ci.yml, .gitlab-ci.yml]
          compare_to: 'refs/heads/$CI_DEFAULT_BRANCH'
      - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BEFORE_SHA != "0000000000000000000000000000000000000000" && $CI_COMMIT_TAG == null'
        changes: [{{.PythonPath}}/**/*, .gitlab/python-ci.yml, .gitlab-ci.yml]
{{- end }}
