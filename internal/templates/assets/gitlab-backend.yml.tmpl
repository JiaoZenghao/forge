.backend-changes:
  rules:
    - changes: [{{.Path}}/**/*, .gitlab/backend-ci.yml, .gitlab-ci.yml]

backend:test:
  extends: .backend-changes
  variables: {MAVEN_OPTS: '-Dmaven.repo.local=$CI_PROJECT_DIR/.m2/repository'}
  stage: test
  image: eclipse-temurin:21-jdk
  script: [cd {{.Path}}, './mvnw --batch-mode test']
  cache:
    key:
      files: [{{.Path}}/pom.xml]
    paths: [.m2/repository/]

backend:package:
  extends: .backend-changes
  variables: {MAVEN_OPTS: '-Dmaven.repo.local=$CI_PROJECT_DIR/.m2/repository'}
  stage: package
  image: eclipse-temurin:21-jdk
  needs: [backend:test]
  script: [cd {{.Path}}, './mvnw --batch-mode -DskipTests package']
  cache:
    key:
      files: [{{.Path}}/pom.xml]
    paths: [.m2/repository/]
  artifacts:
    paths: [{{.Path}}/target/*.jar]
