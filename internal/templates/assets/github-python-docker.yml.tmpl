name: Python
on:
  push: {paths: ['{{.Path}}/**', '.github/workflows/python-ci.yml']}
  pull_request: {paths: ['{{.Path}}/**', '.github/workflows/python-ci.yml']}
permissions: {contents: read}
jobs:
  test:
    runs-on: ubuntu-latest
    defaults: {run: {working-directory: '{{.Path}}'}}
    steps:
      - uses: actions/checkout@v6
      - uses: astral-sh/setup-uv@v9
        with: {enable-cache: true, cache-dependency-glob: '{{.Path}}/uv.lock'}
      - run: uv sync --locked
      - run: uv run python -m compileall .
  image:
    needs: test
    permissions: {contents: read, packages: write}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v6
      - id: image
        run: 'echo "name=ghcr.io/${GITHUB_REPOSITORY,,}/python:${GITHUB_SHA}" >> "$GITHUB_OUTPUT"'
      - uses: docker/setup-buildx-action@v4
      - uses: docker/login-action@v3
        if: github.event_name == 'push' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
        with: {registry: ghcr.io, username: '${{ github.actor }}', password: '${{ secrets.GITHUB_TOKEN }}'}
      - uses: docker/build-push-action@v6
        with: {context: '{{.Path}}', push: "${{ github.event_name == 'push' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch) }}", tags: '${{ steps.image.outputs.name }}'}
